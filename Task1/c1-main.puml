@startuml C1_Мониторинг_Скота_Основное_Решение

!include ../templates/C4_Context.puml

title C1: Платформа мониторинга скота — ОСНОВНОЕ решение (одна центральная система + локальный сервер-агент на каждой ферме)

' === Пользователи ===
Person(оператор, "Оператор", "Работает с центральной системой из головного офиса: следит сразу за несколькими фермами, анализирует события и отчёты")
Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме, реагирует на локальные уведомления, в том числе при отсутствии интернета")

' === Разрабатываемые системы ===
System(агент, "Локальный сервер фермы (агент)", "НОВОЕ. Программно-аппаратный узел на ферме: управляет edge-устройствами, выполняет видеоаналитику в реальном времени, шлёт локальные оповещения, хранит данные при отсутствии интернета. Таких агентов много — по одному на ферму")

System(центр, "Центральная система", "Одна на всю платформу: реестр ферм и агентов, агрегация событий и метрик со всех ферм, роли и доступы, API для веб- и мобильного приложения")

' === Существующий ландшафт АгроТех Х ===
System_Boundary(ландшафт, "Существующий IT-ландшафт АгроТех Х") {
    System(kafka, "Брокер сообщений (Kafka)", "Шина данных компании")
    System(dwh, "Data Lake / DWH + BI", "Хранение данных и отчётность")
    System(erp, "ERP 1С:Агро", "Склад кормов, финансовые операции")
    System(портал, "Веб-портал и мобильное приложение", "Дорабатывается новыми экранами")
}

' === Внешние системы ===
System_Ext(камеры, "Видеокамеры разных производителей")
System_Ext(оборудование, "Кормушки, поилки, фильтрация воды", "Edge-устройства на ферме, оборудование разных производителей")
System_Ext(модель, "ML-модель партнёра", "Нейросеть для распознавания животных")
System_Ext(auth, "Провайдер аутентификации (SSO)")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS, аудиосигналы (сирена)")

' === Связи на ферме (одна ферма = один агент) ===
Rel(камеры, агент, "Видеопоток", "RTSP")
Rel(агент, оборудование, "Отправляет команды и собирает телеметрию")
Rel(модель, агент, "Предоставляет обученную модель")
Rel(агент, дежурный, "Локальные оповещения о ЧП (< 5 сек), работают без интернета")

' === Ферма <-> центральная система ===
Rel(агент, центр, "Синхронизирует накопленные события и метрики", "буферизация при обрыве связи")
Rel(центр, агент, "Конфигурация")

' === Центральная система <-> ландшафт компании ===
Rel(портал, центр, "Запрашивает данные и оповещения", "REST API")
Rel(оператор, портал, "Ипользует веб и мобильное приложение")
Rel(оператор, dwh, "Смотрит отчёты и метрики в BI")
Rel(центр, нотификации, "Отправляет уведомления")
Rel(нотификации, оператор, "Уведомление о ЧП")
Rel(центр, auth, "Аутентификация и авторизация")
Rel(центр, kafka, "Публикует базовые и пользовательские метрики", "Kafka")
Rel(kafka, dwh, "Складывает данные для аналитики")
Rel(центр, erp, "Прогноз расхода корма и заявки на закупку")

SHOW_LEGEND()
@enduml
