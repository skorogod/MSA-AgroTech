@startuml C1_Мониторинг_Скота_Альтернативное_Решение

!include ../templates/C4_Context.puml

title C1: Платформа мониторинга скота — АЛЬТЕРНАТИВНОЕ решение (вся логика в центральной системе, на ферме только шлюз)

' === Пользователи ===
Person(оператор, "Оператор", "Работает с центральной системой из головного офиса: следит сразу за несколькими фермами, анализирует события и отчёты")
Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме, реагирует на уведомления, но получает их только из центра")

' === Разрабатываемые системы ===
System(шлюз, "Тонкий шлюз фермы", "НОВОЕ. Простое устройство на ферме: подключает edge-устройства и передаёт видео и телеметрию в центр. Своей аналитики и хранилища нет")

' === Существующий ландшафт АгроТех Х (центральная система) ===
System_Boundary(ландшафт, "Центральная система на базе IT-ландшафта АгроТех Х") {
    System(видеоаналитика, "Модуль видеоаналитики", "НОВОЕ. Разбирает видеопотоки всех ферм в одном месте")
    System(iot, "IoT-платформа", "Дорабатывается: принимает телеметрию кормушек, поилок, фильтров")
    System(kafka, "Брокер сообщений (Kafka)", "Шина данных компании")
    System(dwh, "Data Lake / DWH + BI", "Хранение данных и отчётность")
    System(erp, "ERP 1С:Агро", "Склад кормов, финансовые операции")
    System(портал, "Веб-портал и мобильное приложение", "Дорабатывается новыми экранами")
}

' === Внешние системы ===
System_Ext(камеры, "Видеокамеры разных производителей")
System_Ext(оборудование, "Кормушки, поилки, фильтрация воды", "Edge-устройства на ферме, оборудование разных производителей")
System_Ext(модель, "ML-модель партнёра", "Нейросеть для распознавания животных")
System_Ext(auth, "Провайдер аутентификации (SSO)")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS")

' === Связи на ферме ===
Rel(камеры, шлюз, "Видеопоток", "RTSP")
Rel(оборудование, шлюз, "Телеметрия и команды")

' === Ферма -> центральная система ===
Rel(шлюз, видеоаналитика, "Передаёт видео в центр", "нужен стабильный канал")
Rel(шлюз, iot, "Передаёт телеметрию оборудования")

' === Внутри центральной системы ===
Rel(модель, видеоаналитика, "Предоставляет обученную модель")
Rel(видеоаналитика, kafka, "Публикует события о ЧП")
Rel(iot, kafka, "Публикует телеметрию")
Rel(kafka, dwh, "Складывает данные для аналитики")
Rel(dwh, erp, "Прогноз расхода корма")
Rel(kafka, нотификации, "Отправляет уведомления")
Rel(портал, kafka, "Запрашивает события", "REST API")
Rel(портал, auth, "Аутентификация и авторизация")

' === Пользователи ===
Rel(оператор, портал, "Использует веб и мобильное приложение")
Rel(оператор, dwh, "Смотрит отчёты и метрики в BI")
Rel(нотификации, дежурный, "Уведомление о ЧП (только при связи с центром)")

SHOW_LEGEND()
@enduml
