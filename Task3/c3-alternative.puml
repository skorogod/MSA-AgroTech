@startuml C3_Сервис_Фермы_Альтернативное_Решение

!include ../templates/C4_Component.puml

title C3: Компоненты сервиса фермы — ВАРИАНТ 2 (модульный монолит на ферме)

Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме")

System_Ext(камеры, "Видеокамеры разных производителей")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS, сирена")

ContainerQueue(mqtt, "MQTT-брокер", "Mosquitto", "Телеметрия оборудования и показания датчиков")
ContainerDb(бд_ф, "Локальная БД", "PostgreSQL", "Инциденты, снимки состояния, пороги правил, буфер синхронизации")
Container(панель, "Локальная панель", $descr="Экран дежурного на ферме")
Container(устройства, "Сервис устройств", $descr="Адаптеры к кормушкам, поилкам, фильтрам")
Container(gateway, "API Gateway центральной системы", "Kong")

Container_Boundary(рантайм, "Сервис фермы — один процесс") {
    Component(видео, "Модуль видеопотоков", $descr="Забирает потоки с камер, готовит кадры")
    Component(аналитика, "Модуль видеоаналитики", "GPU", "Запускает модель партнёра, выдаёт детекции")
    Component(биометрия, "Модуль биометрии", $descr="Принимает показания датчиков, выявляет отклонения")
    Component(шина, "Внутренняя шина событий", $descr="Передача событий между модулями внутри процесса, без брокера. Отбрасывает повторно доставленные события по идентификатору")
    Component(состояние, "Состояние фермы", $descr="Держит в памяти последние показания по животным, загонам и оборудованию. Периодически сохраняет снимок и восстанавливает его при запуске")
    Component(движок, "Движок правил", $descr="Применяет правила к событию и состоянию, создаёт инциденты")
    Component(правила, "Набор правил", $descr="Драки, задавливание поросят, болезнь по биометрии, пересчёт поголовья, отказ оборудования. Это код правил, в БД хранятся только их пороги")
    Component(оповещения, "Модуль локальных оповещений", $descr="Сирена и уведомления дежурному, работает без интернета")
    Component(справочники, "Модуль справочников", $descr="Локальная копия животных, загонов, сотрудников и дежурств. Вызывается внутри процесса")
    Component(репозиторий, "Репозитории", $descr="Свой репозиторий на каждый набор данных: инциденты, снимки состояния, конфигурация правил, буфер синхронизации. Только они работают с локальной БД")
    Component(синхронизация, "Модуль синхронизации", $descr="Отправляет накопленные события в центр, забирает конфигурацию")
    Component(api, "API инцидентов", $descr="Отдаёт список и карточку инцидента локальной панели")
}

Rel(камеры, видео, "Видеопоток", "RTSP")
Rel(видео, аналитика, "Кадры")
Rel(аналитика, шина, "Детекции")
Rel(mqtt, биометрия, "Показания датчиков и телеметрия", "MQTT")
Rel(биометрия, шина, "Состояние животных и отклонения")
Rel(шина, состояние, "Обновляет показания")
Rel(шина, движок, "Передаёт события")
Rel(движок, состояние, "Читает текущее состояние")
Rel(движок, правила, "Проверяет по каждому правилу")
Rel(движок, справочники, "Карточка животного и загон")
Rel(оповещения, справочники, "Кто дежурит сейчас")
Rel(справочники, репозиторий, "Репозиторий справочников")
Rel(движок, оповещения, "Инцидент")
Rel(движок, репозиторий, "Сохраняет инцидент, читает недавние для подавления повторов")
Rel(состояние, репозиторий, "Сохраняет и восстанавливает снимок")
Rel(правила, репозиторий, "Читает пороги правил из БД")
Rel(движок, репозиторий, "Читает список включённых правил")
Rel(движок, устройства, "Задания на кормление и полив", "REST")
Rel(оповещения, нотификации, "Уведомления")
Rel(оповещения, дежурный, "Локальное оповещение (< 5 сек)")
Rel(репозиторий, бд_ф, "Читает и пишет", "SQL")
Rel(синхронизация, репозиторий, "Читает буфер и пишет конфигурацию")
Rel(синхронизация, gateway, "События и метрики, получение конфигурации", "gRPC / HTTPS")
Rel(api, репозиторий, "Запрашивает инциденты")
Rel(панель, api, "Запрашивает инциденты", "REST")
Rel(дежурный, панель, "Смотрит состояние фермы")

Lay_R(биометрия, mqtt)
Lay_D(api, панель)

SHOW_LEGEND()
@enduml
