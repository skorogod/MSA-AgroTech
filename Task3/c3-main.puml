@startuml C3_Сервис_Инцидентов_Основное_Решение

!include ../templates/C4_Component.puml

title C3: Компоненты сервиса инцидентов на ферме — ВАРИАНТ 1 (микросервисы на ферме)

Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме")

ContainerQueue(kafka_ф, "Локальная Kafka", "Kafka", "Топики фермы: детекции, биометрия, телеметрия, инциденты")
ContainerDb(бд_ф, "Локальная БД", "PostgreSQL", "Инциденты, снимки состояния, пороги правил, идентификаторы обработанных событий, буфер синхронизации")
Container(панель, "Локальная панель", $descr="Экран дежурного на ферме")
Container(оповещения_ф, "Сервис локальных оповещений", $descr="Сирена и уведомления дежурному")
Container(синхронизация, "Сервис синхронизации", $descr="Обмен с центральной системой")

Container_Boundary(инциденты, "Сервис инцидентов") {
    Component(потребитель, "Потребитель событий", $descr="Читает топики детекций, биометрии и телеметрии, приводит сообщения к общему виду")
    Component(дедупликация, "Дедупликация событий", $descr="Отбрасывает повторно доставленные сообщения по идентификатору события. Kafka доставляет не менее одного раза, после перезапуска часть событий приходит снова")
    Component(состояние, "Состояние фермы", $descr="Держит в памяти последние показания по животным, загонам и оборудованию. Периодически сохраняет снимок и восстанавливает его при запуске")
    Component(движок, "Движок правил", $descr="Применяет правила к событию и текущему состоянию, решает, создавать ли инцидент")
    Component(правила, "Набор правил", $descr="Драки, задавливание поросят, болезнь по биометрии, пересчёт поголовья, отказ оборудования. Это код правил, в БД хранятся только их пороги")
    Component(конфигурация, "Конфигурация правил", $descr="Принимает обновления порогов из центра, сохраняет их в локальную БД и поднимает оттуда при запуске. Отдаёт правилам действующие значения")
    Component(подавление, "Подавление повторов инцидентов", $descr="Схлопывает поток однотипных детекций в один инцидент. Ключ: тип инцидента, загон и окно времени")
    Component(репозиторий, "Репозитории", $descr="Свой репозиторий на каждый набор данных: инциденты, снимки состояния, конфигурация правил, обработанные события. Только они работают с локальной БД")
    Component(публикатор, "Публикатор инцидентов", $descr="Публикует созданные инциденты в топик")
    Component(api, "API инцидентов", $descr="Отдаёт список и карточку инцидента локальной панели")
}

Rel(kafka_ф, потребитель, "Детекции, биометрия, телеметрия")
Rel(потребитель, дедупликация, "Проверяет идентификатор события")
Rel(дедупликация, репозиторий, "Репозиторий обработанных событий")
Rel(потребитель, состояние, "Обновляет показания")
Rel(потребитель, движок, "Передаёт событие, если оно не повтор")
Rel(движок, состояние, "Читает текущее состояние")
Rel(движок, правила, "Проверяет по каждому включённому правилу")
Rel(конфигурация, правила, "Пороги правил из БД")
Rel(конфигурация, движок, "Список включённых правил из БД")
Rel(движок, подавление, "Проверяет, был ли такой инцидент")
Rel(подавление, репозиторий, "Репозиторий инцидентов: недавние инциденты")
Rel(состояние, репозиторий, "Репозиторий состояния: снимок")
Rel(движок, репозиторий, "Репозиторий инцидентов: сохраняет инцидент")
Rel(движок, публикатор, "Передаёт инцидент")
Rel(публикатор, kafka_ф, "Инциденты")
Rel(kafka_ф, оповещения_ф, "Инциденты для оповещения")
Rel(оповещения_ф, дежурный, "Локальное оповещение (< 5 сек)")
Rel(репозиторий, бд_ф, "Читает и пишет", "SQL")
Rel(kafka_ф, конфигурация, "Обновление конфигурации из центра")
Rel(конфигурация, репозиторий, "Репозиторий конфигурации: включённые правила и пороги")
Rel(синхронизация, kafka_ф, "Конфигурация, полученная из центра")
Rel(синхронизация, бд_ф, "Забирает инциденты для отправки", "SQL")
Rel(api, репозиторий, "Репозиторий инцидентов: список и карточка")
Rel(панель, api, "Запрашивает инциденты", "REST")
Rel(дежурный, панель, "Смотрит состояние фермы")

SHOW_LEGEND()
@enduml
