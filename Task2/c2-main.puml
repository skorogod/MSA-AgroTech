@startuml C2_Мониторинг_Скота_Основное_Решение

!include ../templates/C4_Container.puml

title C2: Платформа мониторинга скота — ВАРИАНТ 1 (микросервисы на ферме, обмен через локальную Kafka)

Person(оператор, "Оператор", "Следит за несколькими фермами из головного офиса")
Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме")

System_Ext(камеры, "Видеокамеры разных производителей")
System_Ext(датчики, "Носимые датчики животных", "Температура, дыхание, сердцебиение")
System_Ext(оборудование, "Кормушки, поилки, фильтрация воды")
System_Ext(модель, "ML-модель партнёра")
System_Ext(auth, "Провайдер аутентификации (SSO)")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS, сирена")

System_Boundary(агент, "Локальный сервер фермы (агент) — по одному на ферму") {
    Container(видео, "Сервис видеопотоков", $descr="Забирает потоки с камер, сохраняет кадры и видеофрагменты, публикует ссылки на них")
    Container(аналитика, "Сервис видеоаналитики", $techn="GPU", $descr="Запускает модель партнёра, распознаёт поведение животных")
    Container(биометрия, "Сервис биометрии", $descr="Принимает показания носимых датчиков, приводит к общему формату, выявляет отклонения")
    Container(инциденты_ф, "Сервис инцидентов", $descr="Правила поверх детекций, биометрии и телеметрии: драки, задавливание поросят, болезнь, пересчёт поголовья. Создаёт инциденты")
    Container(оповещения_ф, "Сервис локальных оповещений", $descr="Сирена и уведомления дежурному, работает без интернета")
    Container(устройства, "Сервис устройств", $descr="Адаптеры к кормушкам, поилкам, фильтрам")
    Container(синхронизация, "Сервис синхронизации", $descr="Копит события и метрики, отправляет в центр, получает конфигурацию")
    Container(панель, "Локальная панель", $descr="Экран дежурного на ферме")
    ContainerQueue(kafka_ф, "Локальная Kafka", "Kafka (KRaft, один брокер)", "Топики фермы: кадры, детекции, инциденты, телеметрия")
    ContainerQueue(mqtt_ф, "MQTT-брокер", "Mosquitto", "Приём телеметрии с оборудования")
    ContainerDb(кадры, "Хранилище кадров", "S3 minio", "Кадры и короткие видеофрагменты")
    ContainerDb(бд_ф, "Локальная БД", "PostgreSQL", "События, телеметрия, буфер синхронизации")
}

System_Boundary(центр, "Центральная система — одна на платформу") {
    Container(gateway, "API Gateway", "Kong", "Единая точка входа: проверка токенов и маршрутизация запросов")
    Container(приём, "Сервис приёма данных", $descr="Принимает пакеты от агентов, отбрасывает повторы по идентификатору события")
    Container(инциденты_ц, "Сервис инцидентов", $descr="Инциденты со всех ферм")
    Container(реестр, "Сервис ферм и устройств", $descr="Реестр ферм, агентов, камер и конфигурации")
    Container(метрики, "Сервис учёта и метрик", $descr="Поголовье, запасы корма, базовые и пользовательские метрики")
    Container(уведомления_ц, "Сервис уведомлений", $descr="Push и SMS оператору")
    ContainerDb(дедуп, "Идентификаторы событий", "Redis", "Идентификаторы принятых событий с ограниченным сроком хранения")
    ContainerDb(бд_ц, "БД центра", "PostgreSQL", "Инциденты, реестр, метрики")
}

System_Boundary(ландшафт, "Существующий IT-ландшафт АгроТех Х") {
    ContainerQueue(kafka, "Брокер сообщений", "Kafka", "Шина данных компании, отдельные топики платформы мониторинга")
    ContainerDb(dwh, "Data Lake / DWH + BI", $descr="Хранение данных и отчётность")
    Container(erp, "ERP 1С:Агро", $descr="Склад кормов, финансовые операции")
    Container(портал, "Веб-портал и мобильное приложение", $descr="Веб и мобильный клиент центральной системы")
}

' === Внутри агента ===
Rel(камеры, видео, "Видеопоток", "RTSP")
Rel(видео, кадры, "Кадры и видеофрагменты")
Rel(видео, kafka_ф, "Ссылки на кадры")
Rel(kafka_ф, аналитика, "Подписка на кадры")
Rel(аналитика, кадры, "Читает кадры")
Rel(модель, аналитика, "Обученная модель")
Rel(аналитика, kafka_ф, "Детекции")
Rel(оборудование, mqtt_ф, "Телеметрия", "MQTT")
Rel(датчики, mqtt_ф, "Показания датчиков", "LoRaWAN / MQTT")
Rel(mqtt_ф, kafka_ф, "Мост телеметрии", "Kafka Connect")
Rel(kafka_ф, биометрия, "Подписка на показания датчиков")
Rel(биометрия, kafka_ф, "Состояние животных")
Rel(kafka_ф, инциденты_ф, "Детекции, биометрия, телеметрия")
Rel(инциденты_ф, kafka_ф, "Инциденты")
Rel(kafka_ф, оповещения_ф, "Подписка на инциденты")
Rel(kafka_ф, устройства, "Задания кормления и полива")
Rel(устройства, оборудование, "Команды", "Modbus / MQTT")
Rel(оповещения_ф, дежурный, "Локальное оповещение (< 5 сек)")
Rel(синхронизация, kafka_ф, "Конфигурация из центра")
Rel(инциденты_ф, бд_ф, "Пишет события", "SQL")
Rel(синхронизация, бд_ф, "Читает буфер", "SQL")
Rel(дежурный, панель, "Смотрит состояние фермы")
Rel(панель, инциденты_ф, "Запрашивает инциденты", "REST")

' === Ферма <-> центр ===
Rel(синхронизация, gateway, "События и метрики, получение конфигурации", "gRPC / HTTPS, пакетами")

' === Внутри центра ===
Rel(gateway, auth, "Проверка токенов", "OIDC")
Rel(gateway, приём, "Запросы агентов", "gRPC")
Rel(приём, дедуп, "Идентификаторы событий", "Redis")
Rel(приём, kafka, "События ферм")
Rel(kafka, инциденты_ц, "Инциденты ферм")
Rel(kafka, метрики, "Метрики и учёт")
Rel(приём, реестр, "Проверка агента, конфигурация", "gRPC")
Rel(инциденты_ц, бд_ц, "Читает и пишет", "SQL")
Rel(реестр, бд_ц, "Читает и пишет", "SQL")
Rel(метрики, бд_ц, "Читает и пишет", "SQL")
Rel(инциденты_ц, kafka, "К оповещению")
Rel(kafka, уведомления_ц, "К оповещению")
Rel(уведомления_ц, нотификации, "Уведомления")
Rel(нотификации, оператор, "Уведомление о ЧП")
Rel(метрики, kafka, "Метрики")

' === Центр <-> ландшафт ===
Rel(kafka, dwh, "Данные для аналитики")
Rel(метрики, erp, "Прогноз расхода корма", "REST")
Rel(портал, gateway, "Данные и инциденты", "REST")
Rel(оператор, портал, "Использует")

SHOW_LEGEND()
@enduml
