@startuml Изоляция_Отдельными_БД

!include ../templates/C4_Container.puml

title Вариант B: отдельная БД на клиента (уровень данных)

Person(клиент_а, "Агрохолдинг А", "Оператор клиента")
Person(клиент_б, "Агрохолдинг Б", "Оператор клиента")

System_Boundary(платформа, "SaaS-платформа") {
    Container(gateway, "API Gateway", "Kong", "Определяет клиента по токену, проставляет идентификатор клиента в запрос")
    Container(сервисы, "Сервисы платформы", $descr="Общий набор экземпляров на всех клиентов. Подключение к БД выбирается по клиенту")
    Container(реестр_бд, "Реестр подключений", $descr="Хранит, в какой базе лежат данные клиента, и выдаёт сервисам параметры подключения")
    ContainerDb(бд_а, "БД клиента А", "PostgreSQL")
    ContainerDb(бд_б, "БД клиента Б", "PostgreSQL")
}

Rel(клиент_а, gateway, "Запросы", "REST")
Rel(клиент_б, gateway, "Запросы", "REST")
Rel(gateway, сервисы, "Запрос с идентификатором клиента", "gRPC")
Rel(сервисы, реестр_бд, "Параметры подключения клиента")
Rel(сервисы, бд_а, "Данные клиента А", "SQL")
Rel(сервисы, бд_б, "Данные клиента Б", "SQL")

note right of реестр_бд
  Данные разнесены физически,
  резервные копии и восстановление
  выполняются по одному клиенту
end note

SHOW_LEGEND()
@enduml
