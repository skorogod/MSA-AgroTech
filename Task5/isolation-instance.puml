@startuml Изоляция_Отдельными_Контурами

!include ../templates/C4_Container.puml

title Вариант C: отдельный контур на клиента (уровень данных)

Person(клиент_а, "Агрохолдинг А", "Оператор клиента")
Person(клиент_б, "Агрохолдинг Б", "Оператор клиента")

System_Boundary(общий, "Общий слой управления") {
    Container(gateway, "API Gateway", "Kong", "Направляет запрос в контур нужного клиента")
    Container(тенанты, "Сервис клиентов и подписок", $descr="Список клиентов, тарифы, адреса контуров")
    Container(биллинг, "Биллинг", $descr="Счета и платежи по всем клиентам")
}

System_Boundary(контур_а, "Контур клиента А") {
    Container(сервисы_а, "Сервисы платформы", $descr="Отдельные экземпляры только для клиента А")
    ContainerDb(бд_а, "БД клиента А", "PostgreSQL")
}

System_Boundary(контур_б, "Контур клиента Б") {
    Container(сервисы_б, "Сервисы платформы", $descr="Отдельные экземпляры только для клиента Б")
    ContainerDb(бд_б, "БД клиента Б", "PostgreSQL")
}

Rel(клиент_а, gateway, "Запросы", "REST")
Rel(клиент_б, gateway, "Запросы", "REST")
Rel(gateway, тенанты, "Определяет контур клиента")
Rel(gateway, сервисы_а, "Запросы клиента А", "gRPC")
Rel(gateway, сервисы_б, "Запросы клиента Б", "gRPC")
Rel(сервисы_а, бд_а, "Читает и пишет", "SQL")
Rel(сервисы_б, бд_б, "Читает и пишет", "SQL")
Rel(тенанты, биллинг, "Тариф и состояние подписки")

note right of контур_б
  Максимальная изоляция,
  но каждый клиент требует
  своих ресурсов и обновления
end note

SHOW_LEGEND()
@enduml
