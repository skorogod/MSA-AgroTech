@startuml C1_SaaS_Платформа

!include ../templates/C4_Context.puml

title C1: SaaS-платформа мониторинга скота — целевая архитектура (To-Be)

Person(админ, "Администратор клиента", "Заводит фермы и сотрудников, выбирает тариф, платит через панель самообслуживания")
Person(оператор, "Оператор клиента", "Следит за фермами своего агрохолдинга")
Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме")
Person(разработчик, "Разработчик клиента", "Интегрирует системы клиента с платформой через API")

System(платформа, "SaaS-платформа мониторинга скота", "Обслуживает несколько агрохолдингов на общей инфраструктуре: данные клиентов изолированы, доступ по подписке")
System(агент, "Агент фермы", "Локальный сервер на ферме клиента: видеоаналитика, биометрия, инциденты, работа без интернета. Принадлежит клиенту, регистрируется в платформе")

System_Ext(оборудование, "Камеры, датчики, кормушки и поилки", "Edge-устройства на ферме клиента")
System_Ext(модель, "ML-модель партнёра", "Нейросеть для распознавания животных")
System_Ext(системы_клиента, "Системы клиента", "ERP, учётные и аналитические системы агрохолдинга")
System_Ext(платежи, "Платёжная система", "Оплата картой и через СБП, эквайринг")
System_Ext(офд, "Оператор фискальных данных", "Чеки по 54-ФЗ")
System_Ext(idp, "Провайдер аутентификации (SSO)")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS, сирена")

Rel(оборудование, агент, "Видео, биометрия, телеметрия")
Rel(модель, агент, "Обученная модель")
Rel(агент, дежурный, "Локальное оповещение (< 5 сек), работает без интернета")
Rel(агент, платформа, "События, метрики и потребление ресурсов", "HTTPS")
Rel(платформа, агент, "Конфигурация и справочники")

Rel(админ, платформа, "Управляет аккаунтом, тарифом и оплатой")
Rel(оператор, платформа, "Смотрит инциденты и отчёты по своим фермам")
Rel(разработчик, платформа, "Читает документацию, получает ключи, вызывает API")
Rel(системы_клиента, платформа, "Обмен данными", "REST API и вебхуки")

Rel(платформа, платежи, "Платежи по подписке")
Rel(платежи, платформа, "Статус платежа", "вебхук")
Rel(платформа, офд, "Фискализация платежей")
Rel(платформа, idp, "Аутентификация и авторизация", "OIDC")
Rel(платформа, нотификации, "Уведомления об инцидентах и счетах")

SHOW_LEGEND()
@enduml
