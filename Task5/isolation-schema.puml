@startuml Изоляция_Схемами_БД

!include ../templates/C4_Container.puml

title Вариант A: изоляция схемами в общей БД (уровень данных)

Person(клиент_а, "Агрохолдинг А", "Оператор клиента")
Person(клиент_б, "Агрохолдинг Б", "Оператор клиента")

System_Boundary(платформа, "SaaS-платформа") {
    Container(gateway, "API Gateway", "Kong", "Определяет клиента по токену, проставляет идентификатор клиента в запрос")
    Container(сервисы, "Сервисы платформы", $descr="Общий набор экземпляров на всех клиентов. Каждый запрос выполняется в схеме своего клиента")
    ContainerDb(бд, "Общая БД платформы", "PostgreSQL", "Одна база, отдельная схема на каждого клиента: tenant_a, tenant_b, ...")
}

Rel(клиент_а, gateway, "Запросы", "REST")
Rel(клиент_б, gateway, "Запросы", "REST")
Rel(gateway, сервисы, "Запрос с идентификатором клиента", "gRPC")
Rel(сервисы, бд, "Работают в схеме своего клиента", "SQL")

note right of бд
  Дешевле всего в эксплуатации,
  но ошибка в коде или в правах
  открывает доступ к чужой схеме
end note

SHOW_LEGEND()
@enduml
