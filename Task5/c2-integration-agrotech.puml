@startuml C2_Интеграция_АгроТех_Х

!include ../templates/C4_Container.puml

title C2: пример интеграции — «АгроТех Х» как клиент SaaS-платформы

Person(оператор, "Оператор АгроТех Х", "Следит за фермами компании")
Person(дежурный, "Дежурный сотрудник", "Находится на конкретной ферме")

System_Boundary(фермы, "Фермы АгроТех Х — по одному агенту на ферму") {
    Container(агент, "Агент фермы", $descr="Видеоаналитика, биометрия, инциденты, локальные оповещения. Работает без интернета")
    ContainerDb(бд_ф, "Локальная БД", "PostgreSQL", "События, справочники, буфер синхронизации")
}

System_Boundary(платформа, "SaaS-платформа (арендатор: АгроТех Х)") {
    Container(gateway, "API Gateway", "Kong", "Токены, определение клиента, лимиты по тарифу")
    Container(сервисы, "Сервисы платформы", $descr="Приём данных, инциденты, животные и персонал, фермы и устройства, уведомления")
    Container(биллинг, "Биллинг и тарификация", $descr="Учёт потребления и счета по подписке")
    ContainerDb(бд_п, "Данные АгроТех Х", "PostgreSQL", "Отдельная схема клиента")
}

System_Boundary(ландшафт, "Существующий IT-ландшафт АгроТех Х") {
    ContainerQueue(kafka, "Брокер сообщений", "Kafka", "Шина данных компании")
    ContainerDb(dwh, "Data Lake / DWH + BI", $descr="Отчётность компании")
    Container(erp, "ERP 1С:Агро", $descr="Склад кормов, финансовые операции, кадры")
    Container(портал, "Веб-портал и мобильное приложение", $descr="Существующий клиент компании")
    Container(коннектор, "Коннектор к платформе", $descr="НОВОЕ. Забирает события и метрики из API платформы и кладёт их в Kafka компании")
}

Rel(агент, дежурный, "Локальное оповещение (< 5 сек)")
Rel(агент, бд_ф, "Читает и пишет", "SQL")
Rel(агент, gateway, "События, метрики, потребление", "HTTPS")
Rel(gateway, сервисы, "Данные агентов", "gRPC")
Rel(сервисы, бд_п, "Читает и пишет", "SQL")
Rel(сервисы, биллинг, "Потребление клиента")

Rel(коннектор, gateway, "Забирает инциденты и метрики", "REST API и вебхуки")
Rel(gateway, коннектор, "Вебхуки об инцидентах", "HTTPS")
Rel(коннектор, kafka, "Публикует события платформы")
Rel(kafka, dwh, "Данные для аналитики")
Rel(сервисы, erp, "Кадры для справочника сотрудников", "REST")
Rel(биллинг, erp, "Счета по подписке", "REST")
Rel(оператор, портал, "Использует привычный портал компании")
Rel(портал, kafka, "Читает события платформы")
Rel(оператор, gateway, "Панель самообслуживания платформы", "REST")

note bottom of коннектор
  Компания остаётся в своих интерфейсах:
  инциденты приходят в её Kafka и портал,
  отдельного входа в платформу
  для повседневной работы не требуется
end note

SHOW_LEGEND()
@enduml
