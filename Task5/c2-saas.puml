@startuml C2_SaaS_Платформа

!include ../templates/C4_Container.puml

title C2: SaaS-платформа мониторинга скота — целевая архитектура (To-Be)

Person(админ, "Администратор клиента", "Аккаунт, тариф, оплата")
Person(оператор, "Оператор клиента", "Инциденты и отчёты по своим фермам")
Person(разработчик, "Разработчик клиента", "Интеграция систем клиента")

System_Ext(агенты, "Агенты ферм клиентов", "Локальные серверы на фермах, вариант 1 из ADR-003")
System_Ext(системы_клиента, "Системы клиента", "ERP и аналитика агрохолдинга")
System_Ext(платежи, "Платёжная система", "Карты, СБП, эквайринг")
System_Ext(офд, "Оператор фискальных данных", "Чеки по 54-ФЗ")
System_Ext(idp, "Провайдер аутентификации (SSO)")
System_Ext(нотификации, "Каналы оповещения", "Push, SMS")

System_Boundary(платформа, "SaaS-платформа") {
    Container(gateway, "API Gateway", "Kong", "Единая точка входа: токены, определение клиента, ограничение частоты запросов по тарифу")
    Container(панель, "Панель самообслуживания", $descr="Регистрация, фермы и сотрудники, тариф, счета и оплата")
    Container(devportal, "Dev-портал", $descr="Документация API, спецификация, песочница, выпуск ключей")

    Container(тенанты, "Сервис клиентов и подписок", $descr="Клиенты, тарифные планы, состав подключённого функционала, лимиты")
    Container(приём, "Сервис приёма данных", $descr="Принимает пакеты от агентов, отбрасывает повторы, проставляет клиента")
    Container(инциденты, "Сервис инцидентов", $descr="Инциденты по всем фермам клиента")
    Container(животные, "Сервис животных и персонала", $descr="Животные, загоны, дежурства. Кадры читаются из систем клиента")
    Container(реестр, "Сервис ферм и устройств", $descr="Фермы, агенты, камеры, конфигурация")
    Container(уведомления, "Сервис уведомлений", $descr="Push и SMS оператору клиента")

    Container(потребление, "Сервис учёта потребления", $descr="Считает фермы, камеры, события и объём хранения по каждому клиенту")
    Container(тарификация, "Сервис тарификации", $descr="Переводит потребление в начисления по тарифному плану клиента")
    Container(биллинг, "Сервис биллинга", $descr="Счета, акты, статус подписки, блокировка при неоплате")
    Container(платёжный, "Адаптер платежей", $descr="Оплата картой и через СБП, приём вебхуков, фискализация чеков")

    ContainerQueue(kafka, "Брокер сообщений", "Kafka", "Топики платформы, разделение по клиентам")
    ContainerDb(бд, "БД платформы", "PostgreSQL", "Схема на клиента, для крупных клиентов — отдельная БД")
    ContainerDb(озеро, "Хранилище данных и аналитика", "S3 + DWH", "Обезличенные данные для отчётности и обучения собственных моделей")
}

' === Клиенты и агенты ===
Rel(агенты, gateway, "События, метрики, потребление", "HTTPS")
Rel(gateway, приём, "Данные агентов", "gRPC")
Rel(системы_клиента, gateway, "Вызовы API клиента", "REST")
Rel(gateway, idp, "Проверка токенов", "OIDC")

Rel(админ, панель, "Управляет аккаунтом и оплатой")
Rel(оператор, панель, "Смотрит инциденты и отчёты")
Rel(разработчик, devportal, "Документация и ключи API")
Rel(панель, gateway, "Запросы", "REST")
Rel(devportal, тенанты, "Выпуск ключей и лимитов")

' === Обработка данных ===
Rel(приём, kafka, "События ферм")
Rel(kafka, инциденты, "Инциденты клиентов")
Rel(kafka, потребление, "Данные для учёта потребления")
Rel(инциденты, kafka, "К оповещению")
Rel(kafka, уведомления, "К оповещению")
Rel(уведомления, нотификации, "Уведомления")
Rel(приём, реестр, "Проверка агента, конфигурация", "gRPC")
Rel(приём, животные, "Справочники для агента", "gRPC")
Rel(gateway, тенанты, "Тариф и лимиты клиента", "gRPC")

Rel(инциденты, бд, "Читает и пишет", "SQL")
Rel(животные, бд, "Читает и пишет", "SQL")
Rel(реестр, бд, "Читает и пишет", "SQL")
Rel(тенанты, бд, "Читает и пишет", "SQL")
Rel(kafka, озеро, "Обезличенные данные")

' === Биллинг ===
Rel(потребление, тарификация, "Потребление за период")
Rel(тарификация, тенанты, "Тарифный план клиента", "gRPC")
Rel(тарификация, биллинг, "Начисления")
Rel(биллинг, бд, "Счета и платежи", "SQL")
Rel(биллинг, платёжный, "Списание по подписке")
Rel(платёжный, платежи, "Платёж", "REST")
Rel(платежи, платёжный, "Статус платежа", "вебхук")
Rel(платёжный, офд, "Чек по 54-ФЗ")
Rel(биллинг, тенанты, "Состояние подписки: активна или заблокирована")

SHOW_LEGEND()
@enduml
